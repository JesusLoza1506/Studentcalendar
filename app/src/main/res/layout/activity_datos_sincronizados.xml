<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/screenBackgroundColor"
    android:padding="@dimen/kalendu_card_padding"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Título -->
        <TextView android:textAppearance="@style/TextAppearance.KalendU.ScreenTitle"
            android:id="@+id/tvSyncDataTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡 Datos Sincronizados"
            android:layout_marginBottom="24dp" />

        <!-- Card: Perfil -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardProfileSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/cardSecondaryBackgroundColor"
            app:cardCornerRadius="@dimen/kalendu_card_radius"
            app:cardElevation="@dimen/kalendu_card_elevation"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👤 Perfil actualizado"
                    android:textColor="?attr/syncProfileTextColor"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="10dp"
                    android:textAlignment="viewStart"
                    />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Clases -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardClassesSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/cardSecondaryBackgroundColor"
            app:cardCornerRadius="@dimen/kalendu_card_radius"
            app:cardElevation="@dimen/kalendu_card_elevation"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvClases"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📘 Clases sincronizadas: -"
                    android:textColor="?attr/syncClassesTextColor"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Tareas -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTasksSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/cardSecondaryBackgroundColor"
            app:cardCornerRadius="@dimen/kalendu_card_radius"
            app:cardElevation="@dimen/kalendu_card_elevation"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvTareas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 Tareas sincronizadas: -"
                    android:textColor="?attr/syncTasksTextColor"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Última sincronización -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLastSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/cardSecondaryBackgroundColor"
            app:cardCornerRadius="@dimen/kalendu_card_radius"
            app:cardElevation="@dimen/kalendu_card_elevation"
            android:layout_marginBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvUltimaSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️ Última sincronización: -"
                    android:textColor="?attr/syncLastSyncTextColor"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>