<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/screenBackgroundColor"
    android:fillViewport="true"
    android:padding="@dimen/kalendu_card_padding">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardEditEvent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/kalendu_card_radius"
            app:cardElevation="@dimen/kalendu_card_elevation"
            app:cardBackgroundColor="?attr/cardBackgroundColor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/kalendu_card_padding">

                <TextView android:textAppearance="@style/TextAppearance.KalendU.ScreenTitle"
                    android:id="@+id/tvEditEventTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✏️ Editar Evento"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="📌 Nombre del evento"
                    android:textColor="?android:textColorPrimary"
                    android:textColorHint="?android:textColorSecondary"
                    android:backgroundTint="?attr/editTextBackgroundTint"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="14dp" />

                <EditText
                    android:id="@+id/etAula"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="🏫 Aula (opcional)"
                    android:textColor="?android:textColorPrimary"
                    android:textColorHint="?android:textColorSecondary"
                    android:backgroundTint="?attr/editTextBackgroundTint"
                    android:inputType="text"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tvTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📂 Tipo"
                    android:textColor="?android:textColorSecondary"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:padding="12dp"
                    android:text="📅 Fecha"
                    android:textColor="?android:textColorPrimary"
                    android:background="@drawable/kalendu_field"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tvHoraInicio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🕐 Hora inicio"
                    android:padding="12dp"
                    android:textColor="?android:textColorPrimary"
                    android:background="@drawable/kalendu_field"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvHoraFin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🕑 Hora fin"
                    android:padding="12dp"
                    android:textColor="?android:textColorPrimary"
                    android:background="@drawable/kalendu_field"
                    android:layout_marginBottom="14dp" />

                <com.google.android.material.button.MaterialButton android:textAllCaps="false"
                    android:id="@+id/tvColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎨 Color"
                    android:textColor="?attr/buttonSecondaryTextColor"
                    android:backgroundTint="?attr/buttonSecondaryBackgroundColor"
                    android:drawablePadding="8dp"
                    android:layout_marginTop="16dp"
                    android:paddingVertical="12dp"
                    app:cornerRadius="@dimen/kalendu_control_radius"
                    app:strokeColor="?attr/buttonSecondaryStrokeColor"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/tvDiasSemana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📆 Días de clase"
                    android:padding="12dp"
                    android:textColor="?android:textColorPrimary"
                    android:background="@drawable/kalendu_field"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/etRepeticion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="🔁 Número de semanas de repetición"
                    android:textColor="?android:textColorPrimary"
                    android:textColorHint="?android:textColorSecondary"
                    android:backgroundTint="?attr/editTextBackgroundTint"
                    android:inputType="number"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.button.MaterialButton android:textAllCaps="false"
                    android:id="@+id/btnGuardarCambios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💾 Guardar cambios"
                    android:textColor="?attr/buttonPrimaryTextColor"
                    android:backgroundTint="?attr/buttonPrimaryBackgroundColor"
                    app:cornerRadius="@dimen/kalendu_control_radius"
                    android:padding="12dp"
                    app:strokeColor="?attr/buttonPrimaryStrokeColor"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton android:textAllCaps="false"
                    android:id="@+id/btnEliminarEvento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🗑️ Eliminar evento"
                    android:textColor="?attr/buttonDestructiveTextColor"
                    android:backgroundTint="?attr/buttonDestructiveBackgroundColor"
                    android:layout_marginTop="12dp"
                    app:cornerRadius="@dimen/kalendu_control_radius"
                    android:padding="12dp"
                    app:strokeColor="?attr/buttonDestructiveStrokeColor"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
