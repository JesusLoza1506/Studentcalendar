<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/kalendu_card_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/imgNuevaFoto"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:src="@drawable/user"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_background"
        android:contentDescription="Foto de perfil" />

    <EditText
        android:id="@+id/etNuevoNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de usuario"
        android:textColorHint="@color/kalendu_muted"
        android:textColor="@color/kalendu_text"
        android:background="@drawable/kalendu_field"
        android:minHeight="48dp"
        android:inputType="textPersonName" />


</LinearLayout>
