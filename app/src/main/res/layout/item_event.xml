<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="1dp"
    app:cardCornerRadius="@dimen/kalendu_card_radius"
    app:cardElevation="@dimen/kalendu_card_elevation">

    <LinearLayout
        android:id="@+id/event_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/tvEventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:text="Nombre del Evento"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp" /> <!-- Permite que el texto se ajuste automáticamente -->

        <TextView
            android:id="@+id/tvEventTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="HH:mm - HH:mm" />

        <TextView
            android:id="@+id/tvEventClassroom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="📍 Aula: X" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
